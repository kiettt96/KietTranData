+    const agent = setup(on, $, () => BIG)
+    const lines = exempts(on)
+    await submit($, A)
+    agent.how = 'deny'
+    await $.tool.call({ tool: 'Agent', tool_use_id: 'n1', agentId: 'a-x', description: 'Việc phụ', prompt: 'x' } as never)
