+    await submit($, 'làm tiếp bước 2')
+    expect(await conductLine($)).toContain('Fable tạm ngừng')
+    await callAgent($, 'u1')
+    expect(lines()).toEqual([])
+    for (let i = 3; i <= 6; i++) await submit($, `làm tiếp bước ${i}`)
