 })
+
+// 0.8.9 R3: ba ca biên. undefined, null và đối tượng không có trường message dạng chuỗi cho thông điệp rỗng (câu cảnh báo giữ dạng cũ);
+// đối tượng có message dạng chuỗi dùng chuỗi đó; chuỗi và số giữ như U3. Hai chỗ đã đúng từ U3 nhưng chưa có ca ghim: thông điệp mở đầu
+// ngay bằng tiền tố, và việc xóa thông điệp cũ trước mỗi lời gọi.
+describe('0.8.9 R3: thông điệp của giá trị bị ném', () => {
+  const reasonOf = async (value: unknown) => (await askRouter(throwing(value), request, parse)).reason
+
+  test('undefined: câu cũ', async () => expect(await reasonOf(undefined)).toBe(OLD))
+  test('null: câu cũ', async () => expect(await reasonOf(null)).toBe(OLD))
+  test('đối tượng rỗng: câu cũ', async () => expect(await reasonOf({})).toBe(OLD))
+  test('đối tượng có message dạng chuỗi: dùng chuỗi đó', async () => expect(await reasonOf({ message: 'x' })).toBe(`${LEAD}x`))
+  test('chuỗi: giữ chuỗi', async () => expect(await reasonOf('y')).toBe(`${LEAD}y`))
+  test('số 42: "42"', async () => expect(await reasonOf(42)).toBe(`${LEAD}42`))
+
+  test('thông điệp mở đầu ngay bằng "$.model.complete: ": bỏ tiền tố', async () => {
+    expect(await reasonOf(new Error('$.model.complete: abc'))).toBe(`${LEAD}abc`)
+  })
+
+  test('lượt đầu ném lỗi có thông điệp, fallback trả null mà không ném lỗi: lý do cuối là câu cũ', async () => {
+    const ask = async (r: ModelCompleteRequest) => {
+      if (String(r.prompt) === 'x') throw new Error('focus-conductor: $.model.complete: model "claude-fable-5-2" is not in this organization\'s allowlist')
+      return null
+    }
+    const fallback = { ...request, prompt: 'fallback', maxTokens: 4_000 } as ModelCompleteRequest
+    const outcome = await askRouter(ask, request, parse, undefined, { now: () => 0, fallback })
+    expect(outcome.result).toBeNull()
+    expect(outcome.reason).toBe(OLD)
+  })
+})
diff --git a/claude-mods/focus-conductor/tests/integration/router-truncated-r2-089.test.ts b/claude-mods/focus-conductor/tests/integration/router-truncated-r2-089.test.ts
new file mode 100644
index 0000000..5cb08b8
--- /dev/null
+++ b/claude-mods/focus-conductor/tests/integration/router-truncated-r2-089.test.ts
@@ -0,0 +1,44 @@
+// 0.8.9 R2 (tích hợp): ba nơi ghi dòng route của nhật ký quyết định (prompt lập mục tiêu hay tiếp nối, tin hỏi tiến độ, tin ngoài lề)
+// đều ghi firstFail khi lượt sau cứu được lượt đầu. Router giả trả JSON hỏng ở lần đầu của mỗi prompt và JSON đúng ở lượt hỏi lại.
+
+import { describe, expect, test } from 'claude-code/testing'
+import { base, plan, step, submit } from '../support/engine'
+
+const PLAN = 'mcp__focus-conductor__plan'
+const LOG = '/tmp/fc-truncated-r2-089.jsonl'
+const MAIN = { model: 'sonnet', effort: 'medium', why: '' }
+const GOAL = plan({ goal: 'Sửa luồng thanh toán', depth: 'substantial', volume: 'medium', kind: 'edit', main: MAIN, requirements: ['Sửa hàm phí'] })
+const STATUS = plan({ relation: 'continue', intent: 'status', goal: '', depth: 'none', volume: 'small', kind: 'answer', main: MAIN })
+const ASIDE = plan({ relation: 'new', intent: 'task', goal: 'Giải thích git rebase', depth: 'none', volume: 'small', kind: 'answer', main: MAIN, tasks: [] })
+const BAD = 'câu trả lời không đúng định dạng'
+
+describe('0.8.9 R2: firstFail ở ba nơi ghi dòng route', () => {
+  test('prompt lập mục tiêu, tin hỏi tiến độ, tin ngoài lề: lượt đầu hỏng JSON, lượt hỏi lại đọc được; ba dòng route có firstFail', { options: { planApproval: 'off', decisionLog: LOG } }, async ($, on) => {
+    const asked = new Map<string, number>()
+    const seen = base(on, {
+      router: request => {
+        const n = (asked.get(request) ?? 0) + 1
+        asked.set(request, n)
+        if (n === 1) return '{"goal": "hỏng'
+        return request.includes('tới đâu rồi') ? STATUS : request.includes('git rebase') ? ASIDE : GOAL
+      },
+    })
+    const writes: string[] = []
+    on('fs.write', (_$, e) => {
+      writes.push(e.text)
+      return { value: undefined }
+    })
+    on('turn.complete', () => ({ text: '' }))
+    await submit($, 'Sửa luồng thanh toán')
+    await $.turn.start({ text: 'làm', turnId: 't1' })
+    await step($, seen, { turnId: 't1' })
+    await $.tool.call({ tool: PLAN, action: 'set', steps: [{ title: 'Sửa hàm phí' }, { title: 'Thêm test' }] } as never)
+    await $.tool.call({ tool: PLAN, action: 'update', step: 1, status: 'doing' } as never)
+    await $.turn.complete({ turnId: 't1', answer: 'ok', durationMs: 5, isAborted: false, reason: 'answer' } as never)
+    await submit($, 'tới đâu rồi')
+    await submit($, 'git rebase là gì')
+    const routes = (writes.at(-1) ?? '').trim().split('\n').filter(Boolean).map(line => JSON.parse(line) as Record<string, unknown>).filter(line => line['kind'] === 'route')
+    expect(routes.map(line => line['intent'])).toEqual(['task', 'status', 'aside'])
+    for (const line of routes) expect(line['firstFail'], String(line['intent'])).toBe(BAD)
+  })
+})
diff --git a/claude-mods/focus-conductor/tests/router-limits-r1-089.test.ts b/claude-mods/focus-conductor/tests/router-limits-r1-089.test.ts
new file mode 100644
index 0000000..4fe8607
--- /dev/null
+++ b/claude-mods/focus-conductor/tests/router-limits-r1-089.test.ts
@@ -0,0 +1,65 @@
+// 0.8.9 R1: timeoutMs, maxTokens và outputTokens của RouterOutcome cùng thuộc lời gọi cuối cùng đã gửi (sau khi kẹp), ở mọi nhánh của
+// askRouter. Dòng router-fail lấy ba trường này, nên ghi đúng giới hạn của lời gọi đã hỏng.
+
+import { describe, expect, test } from 'claude-code/testing'
+import type { ModelCompleteRequest } from 'claude-code'
+import { askRouter, parseRoute } from '../hooks/lib/router'
+import type { Policy } from '../hooks/lib/router'
+import { plan } from './support/engine'
+
+const COND: Policy = { allowFable: false, blocked: new Set(), session: null, conductor: true }
+const REPLY = JSON.stringify(plan({ goal: 'Sửa luồng thanh toán' }))
+const parse = (text: string) => parseRoute(text, COND)
+const usage = (output: number) => ({ input_tokens: 100, output_tokens: output, cache_read_input_tokens: 0, cache_creation_input_tokens: 0 })
+const req = (prompt: string, maxTokens: number, timeoutMs: number, model = 'fable') => ({ model, prompt, maxTokens, timeoutMs }) as ModelCompleteRequest
+const FULL = req('TRỌN', 64_000, 300_000)
+const CUT = req('CẮT', 16_000, 120_000)
+const API = req('API', 32_000, 600_000, 'opus')
+const fields = (o: { timeoutMs: number | null; maxTokens: number | null; outputTokens: number | null }) => ({ timeoutMs: o.timeoutMs, maxTokens: o.maxTokens, outputTokens: o.outputTokens })
+
+describe('0.8.9 R1: giới hạn của lời gọi cuối cùng đã gửi', () => {
+  test('lượt đầu trả lời: giới hạn của request đầu, token ra của câu trả lời đó', async () => {
+    const outcome = await askRouter(async () => ({ isAnswered: true as const, text: REPLY, usage: usage(700) }), FULL, parse, undefined, { now: () => 0 })
+    expect(fields(outcome)).toEqual({ timeoutMs: 300_000, maxTokens: 64_000, outputTokens: 700 })
+  })
+
+  test('request đầu mang maxTokens 128.000: kết quả ghi 64.000 (số đã gửi sau khi kẹp)', async () => {
+    const outcome = await askRouter(async () => ({ isAnswered: true as const, text: REPLY, usage: usage(700) }), req('TRỌN', 128_000, 300_000), parse, undefined, { now: () => 0 })
+    expect(fields(outcome)).toEqual({ timeoutMs: 300_000, maxTokens: 64_000, outputTokens: 700 })
+  })
+
+  test('lượt đầu bị engine từ chối, fallback trả lời: giới hạn và token ra của fallback', async () => {
+    const ask = async (r: ModelCompleteRequest) => {
+      if (String(r.prompt) === 'TRỌN') throw new Error('focus-conductor: $.model.complete: model "claude-fable-5-2" is not in this organization\'s allowlist')
+      return { isAnswered: true as const, text: REPLY, usage: usage(300) }
+    }
+    const outcome = await askRouter(ask, FULL, parse, undefined, { now: () => 0, fallback: CUT })
+    expect(outcome.fellBack).toBe(true)
+    expect(fields(outcome)).toEqual({ timeoutMs: 120_000, maxTokens: 16_000, outputTokens: 300 })
+  })
+
+  test('lượt đầu bị từ chối, fallback hỏng, apiFallback trả lời: giới hạn và token ra của apiFallback', async () => {
+    const ask = async (r: ModelCompleteRequest) => {
+      const prompt = String(r.prompt)
+      if (prompt === 'TRỌN') throw new Error('focus-conductor: $.model.complete: model "claude-fable-5-2" is not in this organization\'s allowlist')
+      if (prompt === 'CẮT') return { isAnswered: true as const, text: '{"goal":', usage: usage(40) }
+      return { isAnswered: true as const, text: REPLY, usage: usage(900) }
+    }
+    const outcome = await askRouter(ask, FULL, parse, undefined, { now: () => 0, fallback: CUT, apiFallback: API })
+    expect(outcome.viaFallback).toBe(true)
+    expect(fields(outcome)).toEqual({ timeoutMs: 600_000, maxTokens: 32_000, outputTokens: 900 })
+  })
+
+  test('lượt hỏi lại vì câu trả lời bị cắt: giới hạn và token ra của lượt hỏi lại', async () => {
+    const sent: ModelCompleteRequest[] = []
+    const ask = async (r: ModelCompleteRequest) => {
+      sent.push(r)
+      return sent.length === 1 ? { isAnswered: true as const, text: '{"goal": "Sửa', usage: usage(16_000) } : { isAnswered: true as const, text: REPLY, usage: usage(5_000) }
+    }
+    const outcome = await askRouter(ask, req('THƯỜNG', 16_000, 100_000, 'sonnet'), parse, undefined, { now: () => 0 })
+    expect(sent.length).toBe(2)
+    expect(outcome.retried).toBe(true)
+    expect(fields(outcome)).toEqual({ timeoutMs: sent[1]?.timeoutMs ?? null, maxTokens: sent[1]?.maxTokens ?? null, outputTokens: 5_000 })
+    expect(sent[1]?.maxTokens).not.toBe(16_000)
+  })
+})
diff --git a/claude-mods/focus-conductor/tests/router-truncated-r2-089.test.ts b/claude-mods/focus-conductor/tests/router-truncated-r2-089.test.ts
new file mode 100644
index 0000000..5a27bb7
--- /dev/null
+++ b/claude-mods/focus-conductor/tests/router-truncated-r2-089.test.ts
@@ -0,0 +1,85 @@
+// 0.8.9 R2: lời gọi có trả lời mà không đọc được, với output_tokens từ 98% maxTokens của request đã gửi lời gọi đó, có lý do "câu trả
+// lời bị cắt ở <n> token ra"; loại lỗi vẫn là format. firstFail được ghi cả khi lượt hỏi lại cứu được một lượt đầu không có kết quả
+// đọc được; lượt hỏi lại vì tin cậy thấp hay vì kiểm phủ yêu cầu thì không ghi, và kết quả rỗng không mang firstFail.
+
+import { describe, expect, test } from 'claude-code/testing'
+import type { ModelCompleteRequest } from 'claude-code'
+import { askRouter, parseRoute } from '../hooks/lib/router'
+import type { Policy } from '../hooks/lib/router'
+import { plan } from './support/engine'
+
+const COND: Policy = { allowFable: false, blocked: new Set(), session: null, conductor: true }
+const REPLY = JSON.stringify(plan({ goal: 'Sửa luồng thanh toán' }))
+const parse = (text: string) => parseRoute(text, COND)
+const usage = (output: number) => ({ input_tokens: 100, output_tokens: output, cache_read_input_tokens: 0, cache_creation_input_tokens: 0 })
+const req = (prompt: string, maxTokens: number, timeoutMs: number, model = 'fable') => ({ model, prompt, maxTokens, timeoutMs }) as ModelCompleteRequest
+const FULL = req('TRỌN', 64_000, 300_000)
+const CUT = req('CẮT', 16_000, 120_000)
+const CUT_AT = 'câu trả lời bị cắt ở 64.000 token ra'
+
+type Reply = { text: string; output: number }
+/** ask trả lần lượt các câu trả lời cho request không phải fallback; request fallback (prompt CẮT) trả kế hoạch đúng. */
+function scripted(replies: Reply[]) {
+  return async (r: ModelCompleteRequest) => {
+    if (String(r.prompt).startsWith('CẮT')) return { isAnswered: true as const, text: REPLY, usage: usage(50) }
+    const reply = replies.shift() ?? { text: '{"goal":', output: 10 }
+    return { isAnswered: true as const, text: reply.text, usage: usage(reply.output) }
+  }
+}
+
+describe('0.8.9 R2: lý do bị cắt và firstFail', () => {
+  test('lượt đọc trọn bị cắt ở 64.000, lượt hỏi lại hỏng, fallback đọc được: firstFail là lý do bị cắt', async () => {
+    const outcome = await askRouter(scripted([{ text: '{"goal": "Sửa', output: 64_000 }, { text: '{"goal":', output: 100 }]), FULL, parse, undefined, { now: () => 0, fallback: CUT, full: { tokenCap: 64_000 } })
+    expect(outcome.result).not.toBeNull()
+    expect(outcome.firstFail).toBe(CUT_AT)
+  })
+
+  test('câu trả lời đầu bị cắt, lượt hỏi lại đọc được: có kết quả, firstFail là lý do bị cắt', async () => {
+    const outcome = await askRouter(scripted([{ text: '{"goal": "Sửa', output: 64_000 }, { text: REPLY, output: 2_000 }]), FULL, parse, undefined, { now: () => 0, fallback: CUT, full: { tokenCap: 64_000 } })
+    expect(outcome.result).not.toBeNull()
+    expect(outcome.fellBack).toBeUndefined()
+    expect(outcome.firstFail).toBe(CUT_AT)
+  })
+
+  test('câu trả lời đầu hỏng JSON với 100 token ra, lượt hỏi lại đọc được: firstFail là câu không đúng định dạng', async () => {
+    const outcome = await askRouter(scripted([{ text: '{"goal":', output: 100 }, { text: REPLY, output: 2_000 }]), FULL, parse, undefined, { now: () => 0, fallback: CUT })
+    expect(outcome.result).not.toBeNull()
+    expect(outcome.firstFail).toBe('câu trả lời không đúng định dạng')
+  })
+
+  test('request thường, cả hai lượt bị cắt: reason nêu token ra của lượt hỏi lại, failure là format', async () => {
+    const sent: ModelCompleteRequest[] = []
+    const ask = async (r: ModelCompleteRequest) => {
+      sent.push(r)
+      return { isAnswered: true as const, text: '{"goal": "Sửa', usage: usage(sent.length === 1 ? 16_000 : (r.maxTokens ?? 0)) }
+    }
+    const outcome = await askRouter(ask, req('THƯỜNG', 16_000, 100_000, 'sonnet'), parse, undefined, { now: () => 0 })
+    expect(sent.length).toBe(2)
+    expect(outcome.result).toBeNull()
+    expect(outcome.failure).toBe('format')
+    expect(outcome.reason).toBe(`câu trả lời bị cắt ở ${String(sent[1]?.maxTokens ?? 0).replace(/\B(?=(\d{3})+(?!\d))/g, '.')} token ra`)
+  })
+
+  test('ngưỡng 98%: 62.720 trên 64.000 token là bị cắt; 62.719 thì không', async () => {
+    const cut = await askRouter(scripted([{ text: '{"goal":', output: 62_720 }, { text: '{"goal":', output: 10 }]), FULL, parse, undefined, { now: () => 0, fallback: CUT })
+    expect(cut.firstFail).toBe('câu trả lời bị cắt ở 62.720 token ra')
+    const plain = await askRouter(scripted([{ text: '{"goal":', output: 62_719 }, { text: '{"goal":', output: 10 }]), FULL, parse, undefined, { now: () => 0, fallback: CUT })
+    expect(plain.firstFail).toBe('câu trả lời không đúng định dạng')
+  })
+
+  test('lượt đầu tin cậy thấp, lượt hỏi lại tin cậy cao: không có firstFail', async () => {
+    const low = JSON.stringify(plan({ goal: 'Sửa luồng thanh toán', confidence: 0.2 }))
+    const high = JSON.stringify(plan({ goal: 'Sửa luồng thanh toán', confidence: 0.9 }))
+    const outcome = await askRouter(scripted([{ text: low, output: 100 }, { text: high, output: 100 }]), FULL, parse, undefined, { now: () => 0, fallback: CUT })
+    expect(outcome.retried).toBe(true)
+    expect(outcome.result?.confidence).toBe(0.9)
+    expect(outcome.firstFail).toBeUndefined()
+  })
+
+  test('mọi lời gọi đều hỏng, kết quả rỗng: không có firstFail', async () => {
+    const ask = async () => ({ isAnswered: true as const, text: '{"goal":', usage: usage(10) })
+    const outcome = await askRouter(ask, FULL, parse, undefined, { now: () => 0, fallback: CUT })
+    expect(outcome.result).toBeNull()
+    expect(outcome.firstFail).toBeUndefined()
+  })
+})
