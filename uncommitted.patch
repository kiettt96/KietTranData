index 0000000..9627325
--- /dev/null
+++ b/claude-mods/focus-conductor/tests/integration/router-truncated-u4-089.test.ts
@@ -0,0 +1,32 @@
+// 0.8.9 U4 (tích hợp): conductor fable, prompt 100.000 ký tự; engine giả trả JSON bị cắt cho request đọc trọn và JSON đúng cho request đã cắt
+// theo trần cũ. Context có bản đọc prompt, có cảnh báo prompt bị lược, mục tiêu không phải mục tiêu tối thiểu, dòng route có firstFail.
+
+import { describe, expect, test } from 'claude-code/testing'
+import type { Engine } from 'claude-code/testing'
+import { PANE, base, plan, submit } from '../support/engine'
+
+const GOAL = 'Mục tiêu router đọc được'
+const MARK = 'DAU_CHO_GIUA_XQ'
+const LONG = `Sửa luồng thanh toán. ${'a'.repeat(60_000)}${MARK}${'b'.repeat(40_000 - 22 - MARK.length)}`
+const paneTexts = async ($: Engine) => (await (await $.ui.mount(PANE)).findAll({ type: 'Text' })).map(e => e.text).join('\n')
+
+describe('0.8.9 U4: lượt đọc trọn bị cắt câu trả lời', () => {
+  test('conductor fable, prompt 100.000 ký tự, câu trả lời của request đọc trọn bị cắt: request đã cắt đọc được; có cảnh báo; mục tiêu không tối thiểu; route có firstFail', { options: { planApproval: 'off', conductor: 'fable', decisionLog: '/tmp/fc-truncated-u4-089.jsonl' } }, async ($, on) => {
+    const writes: string[] = []
+    on('fs.write', (_$, e) => {
+      writes.push(e.text)
+      return { value: undefined }
+    })
+    const seen = base(on, { router: request => (request.includes(MARK) ? '{"goal": "Mục tiêu bị cắt' : plan({ goal: GOAL })) })
+    await submit($, LONG)
+    const prompts = seen.requests.filter(r => r.kind === 'prompt')
+    expect(prompts.at(-1)?.timeoutMs).toBe(120_000)
+    expect(prompts.at(-1)?.prompt.includes(MARK)).toBe(false)
+    expect((seen.contexts.at(-1) ?? []).join('\n')).toContain(GOAL)
+    expect(await paneTexts($)).toContain('router chỉ đọc')
+    const lines = (writes.at(-1) ?? '').trim().split('\n').filter(Boolean).map(line => JSON.parse(line) as Record<string, unknown>)
+    const route = lines.find(line => line['kind'] === 'route')
+    expect(String(route?.['firstFail'] ?? '')).toContain('câu trả lời không đúng định dạng')
+    expect(lines.some(line => line['kind'] === 'router-fail')).toBe(false)
+  })
+})
diff --git a/claude-mods/focus-conductor/tests/router-reason-u3-089.test.ts b/claude-mods/focus-conductor/tests/router-reason-u3-089.test.ts
new file mode 100644
index 0000000..732d720
--- /dev/null
+++ b/claude-mods/focus-conductor/tests/router-reason-u3-089.test.ts
@@ -0,0 +1,46 @@
+// 0.8.9 U3: askRouter giữ thông điệp của lỗi engine ném. Thông điệp gộp về một dòng, bỏ tiền tố tới hết "$.model.complete: ", cắt còn 160
+// ký tự; lý do là "engine từ chối gửi request tới model router: <thông điệp>". Không có thông điệp thì giữ câu cũ. Câu lỗi lấy nguyên văn
+// từ engine thật [Đo trực tiếp, 2.1.325, VERIFICATION mục 0.8.9], tên plugin của mod thử đổi thành focus-conductor.
+
+import { describe, expect, test } from 'claude-code/testing'
+import type { ModelCompleteRequest } from 'claude-code'
+import { askRouter, parseRoute } from '../hooks/lib/router'
+import type { Policy } from '../hooks/lib/router'
+
+const OPEN: Policy = { allowFable: false, blocked: new Set(), session: null }
+const parse = (text: string) => parseRoute(text, OPEN)
+const request: ModelCompleteRequest = { model: 'fable', prompt: 'x', maxTokens: 8_000, timeoutMs: 45_000 } as ModelCompleteRequest
+const OLD = 'engine từ chối gửi request tới model router'
+const LEAD = `${OLD}: `
+const throwing = (value: unknown) => async (): Promise<never> => {
+  throw value
+}
+
+describe('0.8.9 U3: lý do engine từ chối', () => {
+  test('thông điệp của engine thật: lý do giữ phần sau "$.model.complete: "', async () => {
+    const outcome = await askRouter(throwing(new Error('focus-conductor: $.model.complete: maxTokens 128000 is past what claude-fable-5-2 can produce in one reply (64000)')), request, parse)
+    expect(outcome.reason).toBe(`${LEAD}maxTokens 128000 is past what claude-fable-5-2 can produce in one reply (64000)`)
+    expect(outcome.failure).toBe('engine')
+  })
+
+  test('thông điệp 400 ký tự có xuống dòng: phần thông điệp dài đúng 160 ký tự, không có ký tự xuống dòng', async () => {
+    const long = ['a'.repeat(100), 'b'.repeat(99), 'c'.repeat(99), 'd'.repeat(99)].join('\n')
+    expect(long.length).toBe(400)
+    const outcome = await askRouter(throwing(new Error(`focus-conductor: $.model.complete: ${long}`)), request, parse)
+    expect(outcome.reason.startsWith(LEAD)).toBe(true)
+    const message = outcome.reason.slice(LEAD.length)
+    expect(message.length).toBe(160)
+    expect(/[\r\n]/.test(outcome.reason)).toBe(false)
+  })
+
+  test('ask trả null hay ném chuỗi rỗng: giữ câu cũ; ném số 42: thông điệp là "42"; không văng lỗi', async () => {
+    expect((await askRouter(async () => null, request, parse)).reason).toBe(OLD)
+    expect((await askRouter(throwing(''), request, parse)).reason).toBe(OLD)
+    expect((await askRouter(throwing(42), request, parse)).reason).toBe(`${LEAD}42`)
+  })
+
+  test('thông điệp không có tiền tố "$.model.complete: ": giữ nguyên', async () => {
+    const outcome = await askRouter(throwing(new Error('model bị chặn')), request, parse)
+    expect(outcome.reason).toBe(`${LEAD}model bị chặn`)
+  })
+})
diff --git a/claude-mods/focus-conductor/tests/router-refused-u2-089.test.ts b/claude-mods/focus-conductor/tests/router-refused-u2-089.test.ts
new file mode 100644
index 0000000..6df2c7d
--- /dev/null
+++ b/claude-mods/focus-conductor/tests/router-refused-u2-089.test.ts
@@ -0,0 +1,98 @@
+// 0.8.9 U2: lượt đầu bị engine từ chối (ask ném lỗi hay trả null) thì askRouter có đường lùi. Có fallback: gửi fallback; không ra kết quả mà có
+// apiFallback thì gửi tiếp apiFallback. Không có fallback mà có apiFallback: gửi apiFallback. Không có cả hai: như 0.8.8. Mỗi request dự phòng
+// gửi nhiều nhất một lần. Usage của mỗi lời gọi đi kèm model đã nhận lời gọi đó (usageModels); lời gọi bị từ chối không có usage.
+
+import { describe, expect, test } from 'claude-code/testing'
+import type { ModelCompleteRequest } from 'claude-code'
+import { askRouter, parseRoute } from '../hooks/lib/router'
+import type { Policy } from '../hooks/lib/router'
+import { plan } from './support/engine'
+
+const COND: Policy = { allowFable: false, blocked: new Set(), session: null, conductor: true }
+const USAGE = { input_tokens: 100, output_tokens: 50, cache_read_input_tokens: 0, cache_creation_input_tokens: 0 }
+const REPLY = JSON.stringify(plan({ goal: 'Sửa luồng thanh toán' }))
+const parse = (text: string) => parseRoute(text, COND)
+const REFUSED = 'focus-conductor: $.model.complete: model "claude-fable-5-2" is not in this organization\'s allowlist'
+
+const FULL: ModelCompleteRequest = { model: 'fable', prompt: 'TRỌN', maxTokens: 64_000, timeoutMs: 300_000 } as ModelCompleteRequest
+const CUT: ModelCompleteRequest = { model: 'fable', prompt: 'CẮT', maxTokens: 16_000, timeoutMs: 120_000 } as ModelCompleteRequest
+const API: ModelCompleteRequest = { model: 'opus', prompt: 'TRỌN', maxTokens: 64_000, timeoutMs: 300_000 } as ModelCompleteRequest
+
+type Act = 'refuse' | 'null' | 'answer' | 'api-error'
+/** ask theo nhãn model/prompt của request: refuse ném lỗi như engine, null trả null, answer trả kế hoạch, api-error trả lỗi API. */
+function scripted(acts: Record<string, Act>) {
+  const sent: string[] = []
+  const ask = async (r: ModelCompleteRequest) => {
+    const label = `${r.model}/${String(r.prompt)}`
+    sent.push(label)
+    const act = acts[label] ?? 'answer'
+    if (act === 'refuse') throw new Error(REFUSED)
+    if (act === 'null') return null
+    if (act === 'api-error') return { isAnswered: false as const, reason: 'api-error' as const, status: 529, error: 'overloaded' as const, usage: USAGE }
+    return { isAnswered: true as const, text: REPLY, usage: USAGE }
+  }
+  return { ask, sent }
+}
+
+describe('0.8.9 U2: lượt đầu bị engine từ chối', () => {
+  test('dòng 1, có fallback: gửi fallback; có kết quả thì trả kèm fellBack; một usage của fable', async () => {
+    const { ask, sent } = scripted({ 'fable/TRỌN': 'refuse' })
+    const outcome = await askRouter(ask, FULL, parse, undefined, { now: () => 0, fallback: CUT, apiFallback: API })
+    expect(sent).toEqual(['fable/TRỌN', 'fable/CẮT'])
+    expect(outcome.result).not.toBeNull()
+    expect(outcome.fellBack).toBe(true)
+    expect(outcome.viaFallback).toBeUndefined()
+    expect(outcome.usages.length).toBe(1)
+    expect(outcome.usageModels).toEqual(['fable'])
+  })
+
+  test('dòng 1, fallback cũng bị từ chối và có apiFallback: ba request theo thứ tự; kết quả của apiFallback; viaFallback', async () => {
+    const { ask, sent } = scripted({ 'fable/TRỌN': 'refuse', 'fable/CẮT': 'refuse' })
+    const outcome = await askRouter(ask, FULL, parse, undefined, { now: () => 0, fallback: CUT, apiFallback: API })
+    expect(sent).toEqual(['fable/TRỌN', 'fable/CẮT', 'opus/TRỌN'])
+    expect(outcome.result).not.toBeNull()
+    expect(outcome.viaFallback).toBe(true)
+    expect(outcome.usages.length).toBe(1)
+    expect(outcome.usageModels).toEqual(['opus'])
+  })
+
+  test('dòng 1, fallback và apiFallback đều bị từ chối: kết quả rỗng, failure engine, không có request thứ tư', async () => {
+    const { ask, sent } = scripted({ 'fable/TRỌN': 'refuse', 'fable/CẮT': 'null', 'opus/TRỌN': 'refuse' })
+    const outcome = await askRouter(ask, FULL, parse, undefined, { now: () => 0, fallback: CUT, apiFallback: API })
+    expect(sent).toEqual(['fable/TRỌN', 'fable/CẮT', 'opus/TRỌN'])
+    expect(outcome.result).toBeNull()
+    expect(outcome.failure).toBe('engine')
+    expect(outcome.usages).toEqual([])
+  })
+
+  test('dòng 2, không có fallback, có apiFallback: gửi apiFallback; viaFallback; một usage của opus', async () => {
+    const { ask, sent } = scripted({ 'fable/TRỌN': 'refuse' })
+    const outcome = await askRouter(ask, FULL, parse, undefined, { now: () => 0, apiFallback: API })
+    expect(sent).toEqual(['fable/TRỌN', 'opus/TRỌN'])
+    expect(outcome.result).not.toBeNull()
+    expect(outcome.viaFallback).toBe(true)
+    expect(outcome.fellBack).toBeUndefined()
+    expect(outcome.usages.length).toBe(1)
+    expect(outcome.usageModels).toEqual(['opus'])
+  })
+
+  test('dòng 3, không có fallback, không có apiFallback: như 0.8.8, failure engine, không hỏi lại', async () => {
+    const { ask, sent } = scripted({ 'fable/TRỌN': 'refuse' })
+    const outcome = await askRouter(ask, FULL, parse, undefined, { now: () => 0 })
+    expect(sent).toEqual(['fable/TRỌN'])
+    expect(outcome.result).toBeNull()
+    expect(outcome.failure).toBe('engine')
+    expect(outcome.retried).toBe(false)
+    expect(outcome.usages).toEqual([])
+  })
+
+  test('lượt đầu lỗi API, có apiFallback: như 0.8.8, hai request, viaFallback; usage đầu của fable, usage sau của opus', async () => {
+    const { ask, sent } = scripted({ 'fable/TRỌN': 'api-error' })
+    const outcome = await askRouter(ask, FULL, parse, undefined, { now: () => 0, fallback: CUT, apiFallback: API })
+    expect(sent).toEqual(['fable/TRỌN', 'opus/TRỌN'])
+    expect(outcome.result).not.toBeNull()
+    expect(outcome.viaFallback).toBe(true)
+    expect(outcome.usages.length).toBe(2)
+    expect(outcome.usageModels).toEqual(['fable', 'opus'])
+  })
+})
diff --git a/claude-mods/focus-conductor/tests/router-truncated-u4-089.test.ts b/claude-mods/focus-conductor/tests/router-truncated-u4-089.test.ts
