diff --git a/claude-mods/focus-conductor/tests/integration/fresh-b1-087.test.ts b/claude-mods/focus-conductor/tests/integration/fresh-b1-087.test.ts
new file mode 100644
index 0000000..8b08244
--- /dev/null
+++ b/claude-mods/focus-conductor/tests/integration/fresh-b1-087.test.ts
@@ -0,0 +1,84 @@
+// 0.8.7 B1: bước đóng sau chuỗi sửa, test đạt, test lỗi không được tự nâng verified kèm nhãn "chạy đạt"; chạy test đạt lần nữa thì nâng.
+// Cùng luật cho lần kiểm mang cờ shared của subagent chung thư mục khi Fable điều phối. Bước đã nâng trước lần test lỗi giữ như 0.8.6.
+
+import { describe, expect, test } from 'claude-code/testing'
+import type { Engine } from 'claude-code/testing'
+import type { On } from 'claude-code'
+import { JS } from '../fixtures/runner-output'
+import { base, plan, submit, task } from '../support/engine'
+
+const PLAN = 'mcp__focus-conductor__plan'
+const LOG = '/tmp/fc-fresh-b1-087.jsonl'
+const MAIN = { model: 'sonnet', effort: 'medium', why: '' }
+const A = 'Sửa luồng thanh toán'
+const BIG = plan({ goal: A, depth: 'substantial', volume: 'medium', kind: 'edit', main: MAIN, tasks: [task('Sửa hàm phí', 'main', 'sonnet', 'medium'), task('Chạy kiểm', 'agent', 'haiku', 'low', { kind: 'investigate' })] })
+const AUTO = 'tự động'
+
+/** Engine giả: `bun test` đạt, `bun test --fail` lỗi; Agent sinh subagent `a-<tool_use_id>` ngay trong lời gọi. */
+function setup(on: On, $: Engine) {
+  base(on, { router: request => (request.startsWith('Requirements:') ? { missing: [], extra: [], issues: [] } : BIG) })
+  on('tool.call', { tool: 'Edit' }, () => ({ result: 'ok' }))
+  on('tool.call', { tool: 'Bash' }, (_x, e) => {
+    const command = String((e as { command?: unknown }).command ?? '')
+    return command.includes('--fail') ? { result: JS.bun_fail, text: JS.bun_fail, isError: true } : { result: JS.bun_pass, text: JS.bun_pass }
+  })
+  on('tool.call', { tool: 'Agent' }, async (_x, e) => {
+    await $.agent.spawn({ prompt: e.prompt, description: e.description, tool_use_id: String(e.tool_use_id) } as never)
+    return { result: 'đã xong' }
+  })
+  on('agent.spawn', (_x, e) => ({ model: 'claude-sonnet-5-5', agentId: `a-${String(e.tool_use_id)}` }))
+  const writes: string[] = []
+  on('fs.write', (_x, e) => {
+    if (e.path === LOG) writes.push(e.text)
+    return { value: undefined }
+  })
+  const autos = () => (writes.at(-1) ?? '').trim().split('\n').filter(Boolean).filter(line => (JSON.parse(line) as Record<string, unknown>)['kind'] === 'verify-auto').length
+  return { autos }
+}
+const bash = ($: Engine, command: string, agentId?: string) => $.tool.call({ tool: 'Bash', command, ...(agentId !== undefined ? { agentId } : {}) } as never)
+const edit = ($: Engine, agentId?: string) => $.tool.call({ tool: 'Edit', file_path: 'src/phi.ts', old_string: 'a', new_string: 'b', ...(agentId !== undefined ? { agentId } : {}) } as never)
+const close = async ($: Engine, step: number) => String((await $.tool.call({ tool: PLAN, action: 'update', step, status: 'done' })).result)
+const show = async ($: Engine) => String((await $.tool.call({ tool: PLAN, action: 'show' })).result)
+const steps = ($: Engine) => $.tool.call({ tool: PLAN, action: 'set', steps: [{ title: 'Sửa' }, { title: 'Kiểm' }] })
+
+describe('0.8.7 B1: test lỗi chạy sau lần đạt', () => {
+  test('luồng chính: sửa, test đạt, test lỗi, đóng bước 1: bước 1 [x], không "tự động", không verify-auto; test đạt lần nữa: bước 1 [v]', { options: { planApproval: 'off', decisionLog: LOG } }, async ($, on) => {
+    const { autos } = setup(on, $)
+    await submit($, A)
+    await steps($)
+    await edit($)
+    await bash($, 'bun test')
+    await bash($, 'bun test --fail')
+    const out = await close($, 1)
+    expect(out).toContain('[x] 1. Sửa')
+    expect(out).not.toContain(AUTO)
+    expect(autos()).toBe(0)
+    await bash($, 'bun test')
+    expect(await show($)).toContain('[v] 1. Sửa')
+  })
+
+  test('conductor fable: A sửa, B (chung thư mục) test đạt rồi test lỗi, đóng bước 1: bước 1 [x]', { options: { planApproval: 'off', conductor: 'fable', decisionLog: LOG } }, async ($, on) => {
+    setup(on, $)
+    await submit($, A)
+    await steps($)
+    await $.tool.call({ tool: 'Agent', tool_use_id: 'uA', description: 'Việc 1: làm', prompt: 'x' } as never)
+    await edit($, 'a-uA')
+    await $.tool.call({ tool: 'Agent', tool_use_id: 'uB', description: 'Việc 2: làm', prompt: 'x' } as never)
+    await bash($, 'bun test', 'a-uB')
+    await bash($, 'bun test --fail', 'a-uB')
+    const out = await close($, 1)
+    expect(out).toContain('[x] 1. Sửa')
+    expect(out).not.toContain(AUTO)
+  })
+
+  test('sửa, test đạt, đóng bước 1 (đã [v]), rồi test lỗi: bước 1 giữ [v] như 0.8.6', { options: { planApproval: 'off', decisionLog: LOG } }, async ($, on) => {
+    setup(on, $)
+    await submit($, A)
+    await steps($)
+    await edit($)
+    await bash($, 'bun test')
+    expect(await close($, 1)).toContain('[v] 1. Sửa')
+    await bash($, 'bun test --fail')
+    expect(await show($)).toContain('[v] 1. Sửa')
+  })
+})
diff --git a/claude-mods/focus-conductor/tests/integration/headless-status-h1-087.test.ts b/claude-mods/focus-conductor/tests/integration/headless-status-h1-087.test.ts
new file mode 100644
index 0000000..022f022
--- /dev/null
+++ b/claude-mods/focus-conductor/tests/integration/headless-status-h1-087.test.ts
@@ -0,0 +1,87 @@
+// 0.8.7 H1: phiên không tương tác với headlessRouting mặc định (off) làm mod chạy như mode off (0.8.0 A13). /conductor status và câu trả
+// lời của /conductor reroute nêu lý do và cách bật (option headlessRouting là auto rồi mở phiên mới, hoặc /conductor mode auto) ngay sau
+// chữ "Chế độ off", tối đa 160 ký tự. Mode off do người dùng tự đặt không có phần này. Không thêm dòng context nào.
+
+import { describe, expect, test } from 'claude-code/testing'
+import type { Engine } from 'claude-code/testing'
+import type { On } from 'claude-code'
+import { base, plan, submit } from '../support/engine'
+import type { Seen } from '../support/engine'
+
+const GOAL = plan({ goal: 'Sửa hàm tính phí', depth: 'substantial', volume: 'medium' })
+const PRESENTATION = { isFullscreen: false, columns: 80 }
+const run = async ($: Engine, args: string) => String(((await $.command.run({ command: 'conductor', args, origin: { kind: 'composer' }, presentation: PRESENTATION } as never)) as { text?: string }).text ?? '')
+const firstLine = async ($: Engine) => (await run($, 'status')).split('\n')[0] ?? ''
+
+function setup(on: On): Seen {
+  const seen = base(on, { router: () => GOAL })
+  on('session.start', (_$, e) => ({ cwd: e.cwd }))
+  on('turn.complete', () => ({ text: '' }))
+  return seen
+}
+const start = ($: Engine, isInteractive: boolean) => $.session.start({ cwd: '/repo', surface: isInteractive ? 'terminal' : null, isInteractive } as never)
+
+describe('0.8.7 H1: status nêu lý do mode off ở phiên không tương tác', () => {
+  test('phiên không tương tác, option mặc định: có "Chế độ off", headlessRouting và /conductor mode auto; phần thêm không quá 160 ký tự', {}, async ($, on) => {
+    setup(on)
+    await start($, false)
+    const line = await firstLine($)
+    expect(line.startsWith('Chế độ off')).toBe(true)
+    expect(line).toContain('headlessRouting')
+    expect(line).toContain('/conductor mode auto')
+    expect(line.replace('Chế độ off', '').replace('. Chưa có mục tiêu.', '').length).toBeLessThanOrEqual(160)
+  })
+
+  test('đã có mục tiêu (dòng đầu của nhánh có mục tiêu) cũng nêu lý do', {}, async ($, on) => {
+    setup(on)
+    await start($, false)
+    await submit($, 'Sửa hàm tính phí')
+    await run($, 'goal Sửa hàm tính phí')
+    const text = await run($, 'status')
+    expect(text.split('\n')[0] ?? '').toContain('headlessRouting')
+  })
+
+  test('rồi /conductor mode auto: "Chế độ auto", không có headlessRouting', {}, async ($, on) => {
+    setup(on)
+    await start($, false)
+    await run($, 'mode auto')
+    const line = await firstLine($)
+    expect(line.startsWith('Chế độ auto')).toBe(true)
+    expect(await run($, 'status')).not.toContain('headlessRouting')
+  })
+
+  test('phiên không tương tác với headlessRouting auto: "Chế độ auto", không có phần lý do', { options: { headlessRouting: 'auto' } }, async ($, on) => {
+    setup(on)
+    await start($, false)
+    expect((await firstLine($)).startsWith('Chế độ auto')).toBe(true)
+    expect(await run($, 'status')).not.toContain('headlessRouting')
+  })
+
+  test('phiên tương tác, /conductor mode off: "Chế độ off", không có headlessRouting', {}, async ($, on) => {
+    setup(on)
+    await start($, true)
+    await run($, 'mode off')
+    expect((await firstLine($)).startsWith('Chế độ off')).toBe(true)
+    expect(await run($, 'status')).not.toContain('headlessRouting')
+  })
+
+  test('phiên tương tác, option routing off: "Chế độ off", không có headlessRouting', { options: { routing: 'off' } }, async ($, on) => {
+    setup(on)
+    await start($, true)
+    expect((await firstLine($)).startsWith('Chế độ off')).toBe(true)
+    expect(await run($, 'status')).not.toContain('headlessRouting')
+  })
+
+  test('phiên không tương tác, mặc định: /conductor reroute nêu headlessRouting', {}, async ($, on) => {
+    setup(on)
+    await start($, false)
+    expect(await run($, 'reroute')).toContain('headlessRouting')
+  })
+
+  test('phiên không tương tác, mặc định: prompt gửi đi không thêm dòng context nào', {}, async ($, on) => {
+    const seen = setup(on)
+    await start($, false)
+    await submit($, 'Sửa hàm tính phí')
+    expect(seen.contexts.at(-1) ?? []).toEqual([])
+  })
+})
diff --git a/claude-mods/focus-conductor/tests/integration/router-full-l1-087.test.ts b/claude-mods/focus-conductor/tests/integration/router-full-l1-087.test.ts
new file mode 100644
index 0000000..189cd29
--- /dev/null
+++ b/claude-mods/focus-conductor/tests/integration/router-full-l1-087.test.ts
@@ -0,0 +1,93 @@
+// 0.8.7 L1: prompt dài hơn 80.000 ký tự khi router của lượt là Fable (conductor fable, Fable sẵn sàng): request router chứa trọn prompt,
+// không có cảnh báo "router chỉ đọc", context không có CLIPPED_CONTEXT. Fable tạm ngừng (router là option router) và conductor mặc định giữ
+// như 0.8.6. Lượt đọc trọn hết giờ thì lượt dự phòng đọc request đã cắt theo trần 80.000; khi lượt đó được dùng thì có cảnh báo và CLIPPED_CONTEXT.
+
+import { describe, expect, test } from 'claude-code/testing'
+import type { Engine } from 'claude-code/testing'
+import type { On } from 'claude-code'
+import { PANE, ROUTER_TIMEOUT, base, plan, submit } from '../support/engine'
+import type { Json, Seen } from '../support/engine'
+
+const ID = 'claude-fable-5-2'
+const MARK = 'DAU_CHO_GIUA_XQ'
+const LONG = `Sửa luồng thanh toán. ${'a'.repeat(70_000)}${MARK}${'b'.repeat(30_000 - 22 - MARK.length)}`
+const CLIPPED = 'router chưa đọc phần giữa'
+const ONLY = 'router chỉ đọc'
+const BIG = plan({ goal: 'Sửa luồng thanh toán', depth: 'substantial', volume: 'medium', kind: 'edit' })
+const FALLBACK = plan({ goal: 'Mục tiêu theo lượt dự phòng', depth: 'substantial', volume: 'medium', kind: 'edit' })
+const FABLE = { options: { planApproval: 'off', conductor: 'fable' } }
+const PRESENTATION = { isFullscreen: false, columns: 80 }
+
+const paneTexts = async ($: Engine) => (await (await $.ui.mount(PANE)).findAll({ type: 'Text' })).map(e => e.text).join('\n')
+const status = async ($: Engine) => String(((await $.command.run({ command: 'conductor', args: 'status', origin: { kind: 'composer' }, presentation: PRESENTATION } as never)) as { text?: string }).text ?? '')
+const lastContext = (seen: Seen) => (seen.contexts.at(-1) ?? []).join('\n')
+
+function setup(on: On, reply: (model: string, n: number) => Json | string | null): Seen {
+  let n = 0
+  const seen: Seen = base(on, { router: () => reply(seen.routerModels.at(-1) ?? '', n++) })
+  on('turn.complete', () => ({ text: '' }))
+  return seen
+}
+
+describe('0.8.7 L1: Fable đọc trọn prompt dài', () => {
+  test('conductor fable, prompt 100.000 ký tự có dấu ở giữa: request router chứa dấu; không cảnh báo "router chỉ đọc"; không có CLIPPED_CONTEXT', FABLE, async ($, on) => {
+    const seen = setup(on, () => BIG)
+    await submit($, LONG)
+    expect(seen.routerModels[0]).toBe(ID)
+    expect((seen.routed[0] ?? '').includes(MARK)).toBe(true)
+    expect(await paneTexts($)).not.toContain(ONLY)
+    expect(lastContext(seen)).not.toContain(CLIPPED)
+  })
+
+  test('router Fable lỗi hai lần rồi prompt 100.000 ký tự (router là option router): không chứa dấu; cảnh báo 60.000 và 20.000; có CLIPPED_CONTEXT', FABLE, async ($, on) => {
+    const seen = setup(on, model => (model === ID ? null : BIG))
+    await submit($, 'Sửa luồng thanh toán')
+    await submit($, 'làm tiếp bước 1')
+    await submit($, LONG)
+    expect(seen.routerModels.at(-1)).not.toBe(ID)
+    expect((seen.routed.at(-1) ?? '').includes(MARK)).toBe(false)
+    expect(await paneTexts($)).toContain('router chỉ đọc 60.000 ký tự đầu và 20.000 ký tự cuối')
+    expect(lastContext(seen)).toContain(CLIPPED)
+  })
+
+  test('conductor mặc định, prompt 100.000 ký tự: như 0.8.6', { options: { planApproval: 'off' } }, async ($, on) => {
+    const seen = setup(on, () => BIG)
+    await submit($, LONG)
+    expect((seen.routed[0] ?? '').includes(MARK)).toBe(false)
+    expect(await paneTexts($)).toContain('router chỉ đọc 60.000 ký tự đầu và 20.000 ký tự cuối')
+    expect(lastContext(seen)).toContain(CLIPPED)
+  })
+
+  test('Fable đọc trọn prompt dài: chữ chờ ở status line nói đang đọc trọn prompt dài và có thể mất vài phút; context không thêm dòng nào', FABLE, async ($, on) => {
+    const seen = setup(on, () => BIG)
+    await submit($, LONG)
+    expect(seen.statuses).toContain('router Fable đang đọc trọn prompt dài, có thể mất vài phút...')
+    expect(seen.statuses).not.toContain('router đang đọc prompt...')
+    expect(lastContext(seen)).not.toContain('vài phút')
+  })
+
+  test('prompt ngắn khi Fable điều phối: giữ chữ chờ cũ', FABLE, async ($, on) => {
+    const seen = setup(on, () => BIG)
+    await submit($, 'Sửa luồng thanh toán')
+    expect(seen.statuses).toContain('router đang đọc prompt...')
+    expect(seen.statuses.some(s => (s ?? '').includes('vài phút'))).toBe(false)
+  })
+
+  test('conductor mặc định, prompt dài: giữ chữ chờ cũ', { options: { planApproval: 'off' } }, async ($, on) => {
+    const seen = setup(on, () => BIG)
+    await submit($, LONG)
+    expect(seen.statuses).toContain('router đang đọc prompt...')
+    expect(seen.statuses.some(s => (s ?? '').includes('vài phút'))).toBe(false)
+  })
+
+  test('lượt đọc trọn hết giờ, lượt dự phòng nhận request đã cắt theo trần 80.000 và trả kết quả: mục tiêu theo lượt dự phòng; có cảnh báo và CLIPPED_CONTEXT', FABLE, async ($, on) => {
+    const seen = setup(on, (_model, n) => (n === 0 ? ROUTER_TIMEOUT : FALLBACK))
+    await submit($, LONG)
+    expect((seen.routed[0] ?? '').includes(MARK)).toBe(true)
+    expect((seen.routed[1] ?? '').includes(MARK)).toBe(false)
+    expect((seen.routed[1] ?? '').includes('lược')).toBe(true)
+    expect(await status($)).toContain('Mục tiêu theo lượt dự phòng')
+    expect(await paneTexts($)).toContain('router chỉ đọc 60.000 ký tự đầu và 20.000 ký tự cuối')
+    expect(lastContext(seen)).toContain(CLIPPED)
+  })
+})
diff --git a/claude-mods/focus-conductor/tests/router-full-l1-087.test.ts b/claude-mods/focus-conductor/tests/router-full-l1-087.test.ts
new file mode 100644
index 0000000..71c892b
--- /dev/null
+++ b/claude-mods/focus-conductor/tests/router-full-l1-087.test.ts
@@ -0,0 +1,140 @@
+// 0.8.7 L1: khi router của lượt là Fable (isFable), routerRequest đọc trọn prompt tới trần FABLE_REQUEST_CHARS (phần đầu 75%, phần cuối
+// 25% khi vượt); prompt dài hơn REQUEST_CHARS (80.000) thì maxTokens FABLE_FULL_MAX_TOKENS (80.000, chủ mod chốt thay cho 24.000 của
+// đặc tả) và thời gian chờ FABLE_FULL_TIMEOUT_MS; lượt hỏi lại vì bị cắt được tới FABLE_FULL_RETRY_TOKENS. isClippedPrompt và
+// clippedWarning dùng đúng trần của lượt đó. Router thường và prompt không quá 80.000 ký tự giữ request 0.8.6 từng byte. Lượt đọc trọn hết
+// giờ thì askRouter gửi request dự phòng (đã cắt theo trần 80.000) với trọn thời gian chờ của nó, và báo fellBack.
+
+import { describe, expect, test } from 'claude-code/testing'
+import { FABLE_REQUEST_CHARS, askRouter, clippedWarning, isClippedPrompt, parseRoute, retryRequest, routerRequest } from '../hooks/lib/router'
+import type { Policy } from '../hooks/lib/router'
+import { FABLE_FULL_MAX_TOKENS, FABLE_FULL_RETRY_TOKENS, FABLE_FULL_TIMEOUT_MS, FABLE_LONG_TIMEOUT_MS } from '../hooks/lib/conductor'
+import type { ModelCompleteRequest } from 'claude-code'
+import { plan } from './support/engine'
+
+const OPEN: Policy = { allowFable: false, blocked: new Set(), session: null }
+const COND: Policy = { ...OPEN, conductor: true }
+const MARK = 'DAU_CHO_GIUA_XQ'
+const LONG = 'a'.repeat(120_000) + MARK + 'b'.repeat(238_489 - 120_000 - MARK.length)
+const SHORT = 'Sửa luồng thanh toán. ' + 'c'.repeat(5_000 - 22)
+const fable = (text: string) => routerRequest({ text, prev: null, ran: null, policy: COND, model: 'claude-fable-5-2', isFable: true })
+const promptOf = (r: ModelCompleteRequest) => String(r.prompt)
+const grouped = (n: number) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, '.')
+
+const hex = (bytes: ArrayBuffer): string => [...new Uint8Array(bytes)].map(byte => byte.toString(16).padStart(2, '0')).join('')
+const sha = async (text: string) => hex(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text)))
+/** SHA-256 của JSON request, đo trên 45b5161 (0.8.6) bằng engine 2.1.296. */
+const LONG_PLAIN_SHA = 'a6c1b875ed5670668f5713a2080da888a622b958216cab2300288266fbb04b05'
+const SHORT_FABLE_SHA = 'ee1a2caa66e741d838de2072d9b453b1f0f1fd88aa9f47745200220d540c0279'
+
+describe('0.8.7 L1: routerRequest khi router là Fable', () => {
+  test('prompt 238.489 ký tự có dấu ở ký tự 120.000: request chứa dấu, không lược; maxTokens FABLE_FULL_MAX_TOKENS; thời gian chờ FABLE_FULL_TIMEOUT_MS', () => {
+    const r = fable(LONG)
+    expect(promptOf(r).includes(MARK)).toBe(true)
+    expect(promptOf(r).includes('lược')).toBe(false)
+    expect(r.maxTokens).toBe(FABLE_FULL_MAX_TOKENS)
+    expect(r.timeoutMs).toBe(FABLE_FULL_TIMEOUT_MS)
+    expect(isClippedPrompt(LONG, true)).toBe(false)
+  })
+
+  test('prompt dài hơn trần Fable 1 ký tự: request lược đúng số ký tự theo trần Fable; cảnh báo ghi hai con số của trần Fable', () => {
+    const text = 'd'.repeat(FABLE_REQUEST_CHARS + 1)
+    const head = Math.round(FABLE_REQUEST_CHARS * 0.75)
+    const tail = FABLE_REQUEST_CHARS - head
+    expect(promptOf(fable(text)).includes(`[... lược ${text.length - head - tail} ký tự ở giữa ...]`)).toBe(true)
+    expect(isClippedPrompt(text, true)).toBe(true)
+    expect(clippedWarning(text.length, true)).toBe(`Prompt dài ${grouped(text.length)} ký tự; router chỉ đọc ${grouped(head)} ký tự đầu và ${grouped(tail)} ký tự cuối`)
+  })
+
+  test('prompt 80.000 và 80.001 ký tự: bản 80.000 giữ 16.000 và FABLE_LONG_TIMEOUT_MS, bản 80.001 dùng FABLE_FULL_MAX_TOKENS và FABLE_FULL_TIMEOUT_MS; cả hai trọn prompt', () => {
+    const at = fable('e'.repeat(80_000))
+    const over = fable('e'.repeat(80_001))
+    expect([at.maxTokens, at.timeoutMs]).toEqual([16_000, FABLE_LONG_TIMEOUT_MS])
+    expect([over.maxTokens, over.timeoutMs]).toEqual([FABLE_FULL_MAX_TOKENS, FABLE_FULL_TIMEOUT_MS])
+    expect(promptOf(at).includes('e'.repeat(80_000))).toBe(true)
+    expect(promptOf(over).includes('e'.repeat(80_001))).toBe(true)
+    expect(isClippedPrompt('e'.repeat(80_001), true)).toBe(false)
+  })
+
+  test('prompt 5.000 ký tự: request trùng 0.8.6 từng byte', async () => {
+    expect(await sha(JSON.stringify(fable(SHORT)))).toBe(SHORT_FABLE_SHA)
+  })
+})
+
+describe('0.8.7 L1: hằng đã chốt theo số đo', () => {
+  test('FABLE_REQUEST_CHARS 400.000, FABLE_FULL_TIMEOUT_MS 555.000, FABLE_FULL_MAX_TOKENS 80.000, FABLE_FULL_RETRY_TOKENS 120.000', () => {
+    expect([FABLE_REQUEST_CHARS, FABLE_FULL_TIMEOUT_MS, FABLE_FULL_MAX_TOKENS, FABLE_FULL_RETRY_TOKENS]).toEqual([400_000, 555_000, 80_000, 120_000])
+  })
+})
+
+describe('0.8.7 L1: lượt hỏi lại vì câu trả lời bị cắt', () => {
+  test('lượt đọc trọn (maxTokens 80.000) bị cắt: lượt hỏi lại có maxTokens 120.000', () => {
+    expect(retryRequest(fable(LONG), '{"goal":', 'json', { truncated: true }).maxTokens).toBe(FABLE_FULL_RETRY_TOKENS)
+  })
+
+  test('request 16.000 bị cắt: lượt hỏi lại 24.000 như 0.8.6; request 8.000: 12.000', () => {
+    expect(retryRequest(fable('f'.repeat(20_000)), '{"goal":', 'json', { truncated: true }).maxTokens).toBe(24_000)
+    expect(retryRequest(fable(SHORT), '{"goal":', 'json', { truncated: true }).maxTokens).toBe(12_000)
+  })
+})
+
+describe('0.8.7 L1: router thường giữ như 0.8.6', () => {
+  test('isFable vắng, prompt 238.489 ký tự: không chứa dấu, request trùng 0.8.6; maxTokens 16.000; thời gian chờ 120.000; cảnh báo 60.000 và 20.000', async () => {
+    const r = routerRequest({ text: LONG, prev: null, ran: null, policy: OPEN, model: 'sonnet' })
+    expect(promptOf(r).includes(MARK)).toBe(false)
+    expect(await sha(JSON.stringify(r))).toBe(LONG_PLAIN_SHA)
+    expect([r.maxTokens, r.timeoutMs]).toEqual([16_000, 120_000])
+    expect(isClippedPrompt(LONG)).toBe(true)
+    expect(isClippedPrompt(LONG, false)).toBe(true)
+    expect(clippedWarning(LONG.length)).toBe('Prompt dài 238.489 ký tự; router chỉ đọc 60.000 ký tự đầu và 20.000 ký tự cuối')
+  })
+
+  test('isFable false: như vắng', () => {
+    const r = routerRequest({ text: LONG, prev: null, ran: null, policy: COND, model: 'sonnet', isFable: false })
+    expect(promptOf(r).includes(MARK)).toBe(false)
+    expect([r.maxTokens, r.timeoutMs]).toEqual([16_000, 120_000])
+  })
+})
+
+describe('0.8.7 L1: lượt dự phòng khi lượt đọc trọn hết giờ', () => {
+  const reply = JSON.stringify(plan({ goal: 'Sửa luồng thanh toán' }))
+  const USAGE = { input_tokens: 100, output_tokens: 50, cache_read_input_tokens: 0, cache_creation_input_tokens: 0 }
+
+  test('lượt đầu hết giờ (FABLE_FULL_TIMEOUT_MS ở mức sàn 120.000): lượt dự phòng nhận đúng request dự phòng, thời gian chờ đúng 120.000; kết quả báo fellBack', async () => {
+    let t = 0
+    const sent: ModelCompleteRequest[] = []
+    const ask = async (r: ModelCompleteRequest) => {
+      sent.push(r)
+      if (sent.length === 1) {
+        t += r.timeoutMs ?? 0
+        return { isAnswered: false as const, reason: 'aborted' as const, usage: USAGE }
+      }
+      return { isAnswered: true as const, text: reply, usage: USAGE }
+    }
+    const full = { ...fable(LONG), timeoutMs: 120_000 }
+    const fallback = { ...routerRequest({ text: LONG, prev: null, ran: null, policy: COND, model: 'claude-fable-5-2' }), timeoutMs: FABLE_LONG_TIMEOUT_MS }
+    const outcome = await askRouter(ask, full, text => parseRoute(text, COND), undefined, { now: () => t, isFable: true, fallback })
+    expect(sent.length).toBe(2)
+    expect(promptOf(sent[1] as ModelCompleteRequest) === promptOf(fallback)).toBe(true)
+    expect(promptOf(sent[1] as ModelCompleteRequest).includes(MARK)).toBe(false)
+    expect(sent[1]?.timeoutMs).toBe(120_000)
+    expect(outcome.result).not.toBeNull()
+    expect(outcome.fellBack).toBe(true)
+  })
+
+  test('không có request dự phòng: thử lại cùng request như 0.8.6, không báo fellBack', async () => {
+    let t = 0
+    const sent: ModelCompleteRequest[] = []
+    const ask = async (r: ModelCompleteRequest) => {
+      sent.push(r)
+      if (sent.length === 1) {
+        t += 100_000
+        return { isAnswered: false as const, reason: 'aborted' as const, usage: USAGE }
+      }
+      return { isAnswered: true as const, text: reply, usage: USAGE }
+    }
+    const full = fable(LONG)
+    const outcome = await askRouter(ask, full, text => parseRoute(text, COND), undefined, { now: () => t, isFable: true })
+    expect(promptOf(sent[1] as ModelCompleteRequest) === promptOf(full)).toBe(true)
+    expect(outcome.fellBack).toBeUndefined()
+  })
+})
