+// 0.8.9 R2: lời gọi có trả lời mà không đọc được, với output_tokens từ 98% maxTokens của request đã gửi lời gọi đó, có lý do "câu trả
+// lời bị cắt ở <n> token ra"; loại lỗi vẫn là format. firstFail được ghi cả khi lượt hỏi lại cứu được một lượt đầu không có kết quả
+// đọc được; lượt hỏi lại vì tin cậy thấp hay vì kiểm phủ yêu cầu thì không ghi, và kết quả rỗng không mang firstFail.
+
+import { describe, expect, test } from 'claude-code/testing'
+import type { ModelCompleteRequest } from 'claude-code'
+import { askRouter, parseRoute } from '../hooks/lib/router'
+import type { Policy } from '../hooks/lib/router'
+import { plan } from './support/engine'
+
+const COND: Policy = { allowFable: false, blocked: new Set(), session: null, conductor: true }
+const REPLY = JSON.stringify(plan({ goal: 'Sửa luồng thanh toán' }))
+const parse = (text: string) => parseRoute(text, COND)
+const usage = (output: number) => ({ input_tokens: 100, output_tokens: output, cache_read_input_tokens: 0, cache_creation_input_tokens: 0 })
+const req = (prompt: string, maxTokens: number, timeoutMs: number, model = 'fable') => ({ model, prompt, maxTokens, timeoutMs }) as ModelCompleteRequest
+const FULL = req('TRỌN', 64_000, 300_000)
+const CUT = req('CẮT', 16_000, 120_000)
+const CUT_AT = 'câu trả lời bị cắt ở 64.000 token ra'
+
+type Reply = { text: string; output: number }
+/** ask trả lần lượt các câu trả lời cho request không phải fallback; request fallback (prompt CẮT) trả kế hoạch đúng. */
+function scripted(replies: Reply[]) {
+  return async (r: ModelCompleteRequest) => {
+    if (String(r.prompt).startsWith('CẮT')) return { isAnswered: true as const, text: REPLY, usage: usage(50) }
+    const reply = replies.shift() ?? { text: '{"goal":', output: 10 }
+    return { isAnswered: true as const, text: reply.text, usage: usage(reply.output) }
+  }
+}
+
+describe('0.8.9 R2: lý do bị cắt và firstFail', () => {
+  test('lượt đọc trọn bị cắt ở 64.000, lượt hỏi lại hỏng, fallback đọc được: firstFail là lý do bị cắt', async () => {
+    const outcome = await askRouter(scripted([{ text: '{"goal": "Sửa', output: 64_000 }, { text: '{"goal":', output: 100 }]), FULL, parse, undefined, { now: () => 0, fallback: CUT, full: { tokenCap: 64_000 } })
+    expect(outcome.result).not.toBeNull()
+    expect(outcome.firstFail).toBe(CUT_AT)
+  })
+
+  test('câu trả lời đầu bị cắt, lượt hỏi lại đọc được: có kết quả, firstFail là lý do bị cắt', async () => {
+    const outcome = await askRouter(scripted([{ text: '{"goal": "Sửa', output: 64_000 }, { text: REPLY, output: 2_000 }]), FULL, parse, undefined, { now: () => 0, fallback: CUT, full: { tokenCap: 64_000 } })
+    expect(outcome.result).not.toBeNull()
+    expect(outcome.fellBack).toBeUndefined()
+    expect(outcome.firstFail).toBe(CUT_AT)
+  })
+
+  test('câu trả lời đầu hỏng JSON với 100 token ra, lượt hỏi lại đọc được: firstFail là câu không đúng định dạng', async () => {
+    const outcome = await askRouter(scripted([{ text: '{"goal":', output: 100 }, { text: REPLY, output: 2_000 }]), FULL, parse, undefined, { now: () => 0, fallback: CUT })
+    expect(outcome.result).not.toBeNull()
+    expect(outcome.firstFail).toBe('câu trả lời không đúng định dạng')
+  })
+
+  test('request thường, cả hai lượt bị cắt: reason nêu token ra của lượt hỏi lại, failure là format', async () => {
+    const sent: ModelCompleteRequest[] = []
+    const ask = async (r: ModelCompleteRequest) => {
+      sent.push(r)
+      return { isAnswered: true as const, text: '{"goal": "Sửa', usage: usage(sent.length === 1 ? 16_000 : (r.maxTokens ?? 0)) }
+    }
+    const outcome = await askRouter(ask, req('THƯỜNG', 16_000, 100_000, 'sonnet'), parse, undefined, { now: () => 0 })
+    expect(sent.length).toBe(2)
+    expect(outcome.result).toBeNull()
+    expect(outcome.failure).toBe('format')
+    expect(outcome.reason).toBe(`câu trả lời bị cắt ở ${String(sent[1]?.maxTokens ?? 0).replace(/\B(?=(\d{3})+(?!\d))/g, '.')} token ra`)
+  })
+
+  test('ngưỡng 98%: 62.720 trên 64.000 token là bị cắt; 62.719 thì không', async () => {
+    const cut = await askRouter(scripted([{ text: '{"goal":', output: 62_720 }, { text: '{"goal":', output: 10 }]), FULL, parse, undefined, { now: () => 0, fallback: CUT })
+    expect(cut.firstFail).toBe('câu trả lời bị cắt ở 62.720 token ra')
+    const plain = await askRouter(scripted([{ text: '{"goal":', output: 62_719 }, { text: '{"goal":', output: 10 }]), FULL, parse, undefined, { now: () => 0, fallback: CUT })
+    expect(plain.firstFail).toBe('câu trả lời không đúng định dạng')
+  })
+
+  test('lượt đầu tin cậy thấp, lượt hỏi lại tin cậy cao: không có firstFail', async () => {
+    const low = JSON.stringify(plan({ goal: 'Sửa luồng thanh toán', confidence: 0.2 }))
+    const high = JSON.stringify(plan({ goal: 'Sửa luồng thanh toán', confidence: 0.9 }))
+    const outcome = await askRouter(scripted([{ text: low, output: 100 }, { text: high, output: 100 }]), FULL, parse, undefined, { now: () => 0, fallback: CUT })
+    expect(outcome.retried).toBe(true)
+    expect(outcome.result?.confidence).toBe(0.9)
+    expect(outcome.firstFail).toBeUndefined()
+  })
+
+  test('mọi lời gọi đều hỏng, kết quả rỗng: không có firstFail', async () => {
+    const ask = async () => ({ isAnswered: true as const, text: '{"goal":', usage: usage(10) })
+    const outcome = await askRouter(ask, FULL, parse, undefined, { now: () => 0, fallback: CUT })
+    expect(outcome.result).toBeNull()
+    expect(outcome.firstFail).toBeUndefined()
+  })
+})
