+
+  test('thứ tự làm và việc đã gỡ còn sau vòng JSON của Core (như sau hot reload); Core cũ không có hai trường này', () => {
+    const out = applyArrange(goal(5), { order: [5, 1], drop: [{ task: 2, why: 'x' }], merge: [] }, [])
