+
+    test(`${lang}, 60 ràng buộc: đúng 22 mục, 10 mục đầu và 12 mục mới nhất, một dòng nêu 38 mục còn lại, ở 80 và 44 cột`, { options: { planApproval: 'off', neon: 'off', uiLanguage: lang } }, async ($, on) => {
