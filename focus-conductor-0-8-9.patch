+    const seen = base(on, { router: request => (request.includes('điều chỉnh') ? bigAdjust() : plan({ goal: 'Nâng cấp tám mươi tám phần', depth: 'hard', volume: 'large', kind: 'edit', tasks: mains(88) })) })
+    await submit($, 'Nâng cấp tám mươi tám phần')
