+    const at = (lead: string) => block.indexOf(lead)
+    expect(at(ORDER_LEAD)).toBe(0)
+    expect(at('Đã bỏ:')).toBeGreaterThan(at(ORDER_LEAD))
+    expect(at('Đã gộp:')).toBeGreaterThan(at('Đã bỏ:'))
+    expect(at(ASK_LEAD)).toBeGreaterThan(at('Đã gộp:'))
