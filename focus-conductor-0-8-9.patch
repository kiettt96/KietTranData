+      for (const columns of [80, 44]) {
+        const texts = await paneConstraints($, columns)
+        const shown = texts.filter(t => /^Ràng buộc số \d{3}/.test(t))
+        expect(shown, String(columns)).toEqual([...range(1, 10), ...range(49, 60)])
